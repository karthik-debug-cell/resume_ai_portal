# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed browser origins (the React dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# ---------- MongoDB ----------
# Local:  mongodb://127.0.0.1:27017/resume_portal
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resume_portal?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/resume_portal

# ---------- Auth ----------
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Needed to register additional admins once the first admin exists
ADMIN_INVITE_CODE=change-me-invite-code

# ---------- OpenRouter AI ----------
# Get a key at https://openrouter.ai/keys  (server-side only – never put this in the React app)
OPENrouter_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Override only for proxies / testing
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=45000
# Shown in OpenRouter dashboards (optional)
OPENROUTER_APP_URL=http://localhost:5173
OPENROUTER_APP_NAME=ResumeAI Portal

# ---------- Uploads ----------
MAX_FILE_SIZE_MB=5
